TZ=Asia/Shanghai
# Linux bind mount 会保留数字 UID/GID；非 root 且非 1000 的部署账号请改为
# `id -u` / `id -g` 的输出。不要填写 0，Bot 必须保持非 root 运行。
BOT_UID=1000
BOT_GID=1000

BOT_REDIS_HOST=redis
BOT_REDIS_PORT=6379
BOT_REDIS_PASSWORD=
BOT_REDIS_DB=0
BOT_REDIS_CONNECT_TIMEOUT=3.0
BOT_REDIS_SOCKET_TIMEOUT=5.0
BOT_REDIS_HEALTH_CHECK_INTERVAL=30

# Compose 内部 Web 监听固定为 0.0.0.0:8080，以匹配健康检查和 Nginx 上游。

# Compose 固定网络；覆盖两个 Nginx IP 时可信代理 CIDR 会自动同步。
BOT_EDGE_SUBNET=172.30.255.0/24
BOT_NGINX_IP=172.30.255.2
BOT_WEB_IP=172.30.255.3
BOT_BACKEND_SUBNET=172.30.254.0/24
BOT_REDIS_IP=172.30.254.2
BOT_BACKEND_IP=172.30.254.3
BOT_NETEASE_IP=172.30.254.4
BOT_NGINX_BACKEND_IP=172.30.254.5

BOT_NETEASE_BASE_URL=http://netease-api:3000
# Optional: disable features only for troubleshooting.
# BOT_DISABLE_AUTO_START_NETEASE=1
# BOT_DISABLE_VOICE=1

# 可选日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
BOT_LOG_CONSOLE_LEVEL=INFO
BOT_LOG_FILE_LEVEL=DEBUG

# 可选：容器内强制直连，避免继承宿主机代理
BOT_OOPZ_PROXY=direct

# 官方备用 HTTP / WebSocket 线路；默认仍使用主线路。
# BOT_OOPZ_BASE_URL=https://gateway1.oopz.cn
# BOT_OOPZ_WS_URL=wss://ws1.oopz.cn
